# BAMY 环境变量示例（《配置项》第三节）
#
#   cp .env.example .env && chmod 600 .env
#
# 优先级：环境变量 > config/config.yaml > 数据库配置 > 内置默认值。修改后需重启生效。
# 本文件用于 apt + pip 手动安装（含 Termux）。Docker Compose 部署请用 docker/.env.docker.example。
# .env 已被 .gitignore 忽略，切勿提交。

# =====================================================================
# 3.1 必需项
# =====================================================================

# JWT 签名密钥。字符串，长度 ≥ 32，不得与示例值相同。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 敏感字段加密密钥（币安 API 密钥等）。字符串，长度 ≥ 32，必须与 SECRET_KEY 不同。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
# 有数据后不可随意更换，否则已加密数据无法解密；请单独离线备份。
ENCRYPT_KEY=

# 数据库连接串（《配置项》3.3）。连接池参数写在 config/config.yaml，不写在连接串里。
#   开发与小规模 / Termux：sqlite+aiosqlite:///<路径>
#   生产：postgresql+asyncpg://<用户>:<密码>@<主机>:<端口>/<库名>（独立账号，非超级用户）
DATABASE_URL=sqlite+aiosqlite:///./data/bamy.db
# DATABASE_URL=postgresql+asyncpg://bamy_app:<密码>@127.0.0.1:5432/bamy

# 运行环境。枚举：dev / prod。prod 下 SECRET_KEY / ENCRYPT_KEY / DATABASE_URL 必须显式提供。
APP_ENV=dev

# =====================================================================
# 3.2 可选项（下列值即默认值，不写也一样）
# =====================================================================

# 应用名。1-32 字符。默认 BAMY
APP_NAME=BAMY

# 监听地址。合法 IPv4。默认 0.0.0.0
APP_HOST=0.0.0.0

# 监听端口。1-65535。默认 8000
APP_PORT=8000

# 日志级别。debug / info / warning / error。默认 info
LOG_LEVEL=info

# 日志目录。可写路径。默认 ./logs
LOG_DIR=./logs

# 是否允许实盘下单。true / false。默认 false（只做币安现货；关闭时只能跑模拟盘）
ENABLE_LIVE_TRADING=false

# 访问 token 有效期（秒）。60-86400。默认 1800
ACCESS_TOKEN_EXPIRE=1800

# 刷新 token 有效期（秒）。3600-2592000。默认 604800（7 天）
REFRESH_TOKEN_EXPIRE=604800

# 是否允许注册。true / false。默认 true
ALLOW_REGISTER=true

# 是否允许邮箱注册。true / false。默认 false（prod 下为 true 会有安全警告）
ALLOW_EMAIL_REGISTER=false

# 是否允许邀请码注册。true / false。默认 false（prod 下为 true 会有安全警告）
ALLOW_INVITE_REGISTER=false

# 崩溃后自动恢复实例。true / false。默认 true
AUTO_RECOVER_ON_BOOT=true

# 启动恢复并发数。1-50。默认 5
RECOVER_CONCURRENCY=5

# 单实例恢复超时（秒）。5-600。默认 60
RECOVER_TIMEOUT=60

# 恢复前先对账。true / false。默认 true
RECONCILE_BEFORE_RECOVER=true

# 定时对账间隔（秒）。5-3600。默认 30
RECONCILE_INTERVAL=30

# 账号探活间隔（秒）。10-3600。默认 60
HEALTH_CHECK_INTERVAL=60

# 单用户实例数上限。1-1000。默认 50
MAX_INSTANCES_PER_USER=50

# 扩展根目录。可读路径。默认 ./extensions
EXTENSION_DIR=./extensions

# 策略目录。可读路径。默认 ./extensions/strategies
STRATEGY_DIR=./extensions/strategies

# 插件目录。可读路径。默认 ./extensions/plugins
PLUGIN_DIR=./extensions/plugins

# 初始管理员用户名。3-32 字符。默认空（空则首次访问 /setup 创建）
INIT_ADMIN_USER=

# 初始管理员密码。满足密码规则。默认空。首次登录后立即修改并从本文件删除。
INIT_ADMIN_PASS=

# ---- 反向代理与邮件（可选）----
# 只信任这些来源写入的 X-Forwarded-For（逗号分隔 IP/CIDR）。native 直连默认 127.0.0.1；docker 默认容器内网段
FORWARDED_ALLOW_IPS=
# 密码找回邮件。未配置 SMTP_HOST 时找回功能不发信，由管理员在后台为用户生成临时密码
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# starttls / ssl / none
SMTP_TLS=starttls
# 邮件里重置链接的站点地址，如 https://bamy.example.com
PUBLIC_BASE_URL=
