# BAMY HTTPS 片段（《部署与运行》14.2 / 14.4：生产强制 HTTPS + HSTS）
#
# 用法：
#   1. 把证书放到 docker/certs/fullchain.pem 与 docker/certs/privkey.pem（文件已被 .gitignore 忽略）
#   2. 用本文件的两个 server 块替换 docker/nginx.conf 里的 `server { listen 80; ... }` 整块，
#      并把原 server 块里的 location 段原样拷进下面的 443 server 块
#   3. docker-compose.yml 的 nginx 服务：
#        ports 增加   - "${HTTPS_PORT:-443}:443"
#        volumes 增加 - ./certs:/etc/nginx/certs:ro
#   4. docker compose -f docker/docker-compose.yml up -d nginx

server {
    listen 80;
    server_name _;
    location = /nginx-health { access_log off; default_type text/plain; return 200 "ok\n"; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    root  /usr/share/nginx/html;
    index index.html;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' wss:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;

    proxy_http_version 1.1;
    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Request-ID      $request_id;
    proxy_set_header Connection        "";

    # —— 把 docker/nginx.conf 中 80 server 块里的全部 location 段拷到这里 ——
}
