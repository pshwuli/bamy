# BAMY 生产环境变量模板（Docker Compose）
#
#   cp docker/.env.docker.example docker/.env && chmod 600 docker/.env
#
# 下面所有留空的密钥/密码都必须自己生成，留空或与示例相同会导致启动失败或不安全。
# 生成命令（每项单独执行一次，结果互不相同）：
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# docker/.env 已被 .gitignore 忽略，切勿提交。

# ---------- 必需项 ----------
APP_ENV=prod

# JWT 签名密钥，长度 ≥ 32。必须自己生成。
SECRET_KEY=
# 敏感字段（币安 API 密钥等）加密密钥，长度 ≥ 32，必须与 SECRET_KEY 不同。必须自己生成。
# 一旦有数据入库就不可随意更换，否则已加密的数据无法解密；请单独离线备份（《部署与运行》11.1）。
ENCRYPT_KEY=

# 数据库连接串。留空时由 compose 用下面的 BAMY_DB_* 自动拼成：
#   postgresql+asyncpg://${BAMY_DB_USER}:${BAMY_DB_PASSWORD}@db:5432/${POSTGRES_DB}
# 使用外部/云数据库时在此显式填写（密码中的特殊字符需 URL 编码）。
DATABASE_URL=

# ---------- PostgreSQL 容器 ----------
POSTGRES_DB=bamy
# 数据库超级用户，只用于初始化与备份，不给应用使用
POSTGRES_USER=postgres
# 必须自己生成
POSTGRES_PASSWORD=
# 应用独立账号（首次初始化时由 docker/postgres-init 创建）
BAMY_DB_USER=bamy_app
# 必须自己生成
BAMY_DB_PASSWORD=

# ---------- 对外端口 ----------
HTTP_PORT=80
HTTPS_PORT=443
# 后端直连端口，默认监听 0.0.0.0（内网穿透可直接转发）；只想本机访问就把 APP_BIND 设成 127.0.0.1
APP_PORT=8000
APP_BIND=0.0.0.0

# ---------- 可选服务 ----------
# 启用 Redis：取消注释
# COMPOSE_PROFILES=redis

# ---------- 应用可选项（缺省即默认值，见根目录 .env.example）----------
APP_NAME=BAMY
LOG_LEVEL=info
# 实盘下单总开关。默认 false：只能跑模拟盘。确认风控就绪后再改为 true。
ENABLE_LIVE_TRADING=false
ACCESS_TOKEN_EXPIRE=1800
REFRESH_TOKEN_EXPIRE=604800
ALLOW_REGISTER=true
# prod 下为 true 会在启动日志产生安全警告
ALLOW_EMAIL_REGISTER=false
ALLOW_INVITE_REGISTER=false
AUTO_RECOVER_ON_BOOT=true
RECOVER_CONCURRENCY=5
RECOVER_TIMEOUT=60
RECONCILE_BEFORE_RECOVER=true
RECONCILE_INTERVAL=30
HEALTH_CHECK_INTERVAL=60
MAX_INSTANCES_PER_USER=50

# 初始管理员（可选）。填写后首次启动直接创建管理员，无需访问 /setup；
# 首次登录后立即修改密码，并从本文件删除这两行。
INIT_ADMIN_USER=
INIT_ADMIN_PASS=

TZ=Asia/Shanghai

# ---------- 备份（scripts/backup.sh）----------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7

# ---- 反向代理与邮件（可选）----
# 只信任这些来源写入的 X-Forwarded-For（逗号分隔 IP/CIDR）。native 直连默认 127.0.0.1；docker 默认容器内网段
FORWARDED_ALLOW_IPS=
# 密码找回邮件。未配置 SMTP_HOST 时找回功能不发信，由管理员在后台为用户生成临时密码
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# starttls / ssl / none
SMTP_TLS=starttls
# 邮件里重置链接的站点地址，如 https://bamy.example.com
PUBLIC_BASE_URL=
